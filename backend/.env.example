GEMINI_API_KEY=your_gemini_api_key_here

# optional model overrides. both default to gemini-3.1-flash-lite, which has a
# much larger free tier allowance than gemini-3.5-flash (capped at 20 requests
# a day). the chat agent burns one request per tool round, so it runs out fast.
# GEMINI_ANALYZE_MODEL=gemini-3.1-flash-lite
# GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
