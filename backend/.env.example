GEMINI_API_KEY=your_gemini_api_key_here

# optional model overrides. all default to gemini-3.1-flash-lite, which has a
# much larger free tier allowance than gemini-3.5-flash (capped at 20 requests
# a day). the chat agent burns one request per tool round, so it runs out fast.
# GEMINI_ANALYZE_MODEL=gemini-3.1-flash-lite
# GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
# GEMINI_CODEGEN_MODEL=gemini-3.1-flash-lite

# ---------------------------------------------------------------- local model
# ReqFlow only ever runs on your own machine, so the model can too: no key, no
# quota, no round trip, and your project's code never leaves the laptop.
#
# There are two ways to do it. The desktop app sets the first one for you — it
# downloads the weights on first launch and passes the path in — so this is for
# running from a checkout.
#
# 1. In this process, from a .gguf file. Nothing to install and nothing to keep
#    running: the weights are loaded by the backend itself.
#
#      LLM_PROVIDER=embedded
#      LOCAL_MODEL_PATH=/path/to/your-model.gguf
#
#    The desktop app offers a short list and downloads one for you. Which models
#    are on that list is decided by measuring them, not by brand: decode speed is
#    bound by memory bandwidth, that memory is shared with your own dev server,
#    and a model that swaps is slower than the cloud call it replaced. A smaller
#    model trained for code can beat a larger general one at this particular job.
#
# 2. A runtime you already have, over its OpenAI-compatible API. Ollama,
#    llama.cpp's server and LM Studio all speak it.
#
#      ollama pull <the model you want>
#      LLM_PROVIDER=local
#      LOCAL_MODEL_URL=http://localhost:11434/v1
#
# The weights are not shipped with ReqFlow either way: gigabytes with their own
# licence are not ours to redistribute.
#
# LLM_PROVIDER=embedded
# LOCAL_MODEL_PATH=

# How much context the embedded model gets. The scan batches your project
# against this, so raising it means fewer batches and more memory for the KV
# cache on a machine that is also running the project under test.
# LOCAL_CONTEXT_TOKENS=8192

# for the separate-runtime option
# LOCAL_MODEL=
# LOCAL_MODEL_URL=http://localhost:11434/v1

# per job, if one of them wants a different size of model than the others
# LOCAL_ANALYZE_MODEL=
# LOCAL_CHAT_MODEL=
# LOCAL_CODEGEN_MODEL=
